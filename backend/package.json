    "@types/express": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0"
  }
